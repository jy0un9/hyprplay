<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.jy0un9.hyprplay</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Hyprplay</name>
  <summary>Local FLAC, Opus, Ogg, MP3, M4A, and AAC music player</summary>
  <description>
    <p>
      Local music player for Linux with libmpv playback, library browser,
      playlists, tag editing, optional Discogs enrichment, lyrics, and MPRIS2.
    </p>
  </description>
  <url type="homepage">https://github.com/jy0un9/hyprplay</url>
  <url type="bugtracker">https://github.com/jy0un9/hyprplay/issues</url>
  <developer id="org.jy0un9">
    <name>jy0un9</name>
  </developer>
  <launchable type="desktop-id">hyprplay.desktop</launchable>
  <icon type="stock">hyprplay</icon>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <keywords>
    <keyword>music</keyword>
    <keyword>audio</keyword>
    <keyword>flac</keyword>
    <keyword>opus</keyword>
    <keyword>ogg</keyword>
    <keyword>mp3</keyword>
    <keyword>m4a</keyword>
    <keyword>player</keyword>
    <keyword>library</keyword>
    <keyword>hyprland</keyword>
  </keywords>
  <content_rating type="oars-1.1"/>
  <screenshots>
