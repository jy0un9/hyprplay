<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.jy0un9.hyprplay</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Hyprplay</name>
  <summary>Local FLAC, Opus, MP3, and M4A music player</summary>
  <description>
    <p>
      Local music player for Linux with libmpv playback, library browser,
      playlists, tag editing, lyrics, and MPRIS2.
    </p>
