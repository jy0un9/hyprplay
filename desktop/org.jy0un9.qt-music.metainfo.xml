<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.jy0un9.qt-music</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Qt Music</name>
  <summary>Local FLAC, Opus, MP3, and M4A music player</summary>
  <description>
    <p>
      A native Qt 6 desktop music player for local libraries on Linux,
      with a library browser, libmpv playback, playlists, tag editing,
      import inbox, synced lyrics, Discogs metadata, Omarchy theme sync,
      and MPRIS2 integration.
    </p>
  </description>
  <url type="homepage">https://github.com/jy0un9/qt-music</url>
  <url type="bugtracker">https://github.com/jy0un9/qt-music/issues</url>
  <developer id="org.jy0un9">
    <name>jy0un9</name>
  </developer>
  <launchable type="desktop-id">qt-music.desktop</launchable>
  <icon type="stock">qt-music</icon>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <keywords>
    <keyword>music</keyword>
    <keyword>audio</keyword>
    <keyword>flac</keyword>
    <keyword>opus</keyword>
    <keyword>mp3</keyword>
    <keyword>m4a</keyword>
    <keyword>player</keyword>
    <keyword>library</keyword>
  </keywords>
  <content_rating type="oars-1.1"/>
  <!-- Screenshot URL restored when the repo is public / AUR-ready.
       Local asset: docs/assets/library-browse.png -->
  <provides>
    <dbus type="session">org.mpris.MediaPlayer2.qt-music</dbus>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-09-14"/>
  </releases>
</component>
