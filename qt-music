#!/usr/bin/env bash
# Launch qt-music with display auto-detection (Omarchy/Hyprland).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$DIR/../lib/qt-music/qt-music-bin" ]]; then
  BIN="$DIR/../lib/qt-music/qt-music-bin"
elif [[ -x "$DIR/qt-music-bin" ]]; then
  BIN="$DIR/qt-music-bin"
else
  echo "qt-music: binary not found (expected qt-music-bin next to launcher)." >&2
  exit 1
fi

if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$(id -u)" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if [[ -z "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
  for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
    [[ -e "$sock" ]] || continue
    export WAYLAND_DISPLAY="$(basename "$sock")"
    break
  done
fi

if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" \
      && -e "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; then
  export QT_QPA_PLATFORM=wayland
elif [[ -n "${DISPLAY:-}" ]]; then
  unset QT_QPA_PLATFORM
else
  echo "qt-music: no Wayland or X11 display found." >&2
  echo "  Open a terminal inside Hyprland, or run: WAYLAND_DISPLAY=wayland-1 $0" >&2
  exit 1
fi

if [[ -z "${PULSE_SERVER:-}" && -n "${XDG_RUNTIME_DIR:-}" && -e "${XDG_RUNTIME_DIR}/pulse/native" ]]; then
  export PULSE_SERVER="unix:${XDG_RUNTIME_DIR}/pulse/native"
fi

exec "$BIN" "$@"
