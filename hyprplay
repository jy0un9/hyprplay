#!/usr/bin/env bash
# Launch hyprplay with display auto-detection (Omarchy/Hyprland).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$DIR/../lib/hyprplay/hyprplay-bin" ]]; then
  BIN="$DIR/../lib/hyprplay/hyprplay-bin"
elif [[ -x "$DIR/hyprplay-bin" ]]; then
  BIN="$DIR/hyprplay-bin"
else
  echo "hyprplay: binary not found (expected hyprplay-bin next to launcher)." >&2
  exit 1
fi

# Warn when both /usr/local and ~/.local installs exist (stale-binary trap).
PRIMARY_BIN="/usr/local/lib/hyprplay/hyprplay-bin"
ALT_BIN="${HOME}/.local/lib/hyprplay/hyprplay-bin"
if [[ -x "$PRIMARY_BIN" && -x "$ALT_BIN" ]]; then
  case "$BIN" in
    "$PRIMARY_BIN") ;;
    *)
      echo "hyprplay: warning: both installs exist:" >&2
      echo "  primary: $PRIMARY_BIN" >&2
      echo "  also:    $ALT_BIN" >&2
      echo "  running: $BIN" >&2
      echo "  Prefer /usr/local. Remove the user install with:" >&2
      echo "    qmake6 hyprplay.pro PREFIX=\"\$HOME/.local\" && make uninstall" >&2
      ;;
  esac
fi

if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$(id -u)" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if [[ -z "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
  for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
    [[ -e "$sock" ]] || continue
    export WAYLAND_DISPLAY="$(basename "$sock")"
    break
  done
fi

if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" \
      && -e "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; then
  export QT_QPA_PLATFORM=wayland
elif [[ -n "${DISPLAY:-}" ]]; then
  unset QT_QPA_PLATFORM
else
  echo "hyprplay: no Wayland or X11 display found." >&2
  echo "  Open a terminal inside Hyprland, or run: WAYLAND_DISPLAY=wayland-1 $0" >&2
  exit 1
fi

if [[ -z "${PULSE_SERVER:-}" && -n "${XDG_RUNTIME_DIR:-}" && -e "${XDG_RUNTIME_DIR}/pulse/native" ]]; then
  export PULSE_SERVER="unix:${XDG_RUNTIME_DIR}/pulse/native"
fi

exec "$BIN" "$@"
